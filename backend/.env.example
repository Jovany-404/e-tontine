# ---------- Application ----------
APP_NAME="e-Tontine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# URL du frontend React (utilisée par le CORS)
FRONTEND_URL=http://localhost:5173

# Langue : "en" pour l'instant. Les traductions françaises seront ajoutées en Phase 3.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ---------- Logs ----------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------- Base de données (MySQL / MariaDB XAMPP) ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etontine
DB_USERNAME=etontine
DB_PASSWORD=

# ---------- Session / cache / queue (simples en dev) ----------
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ---------- Emails : écrits dans storage/logs/laravel.log en dev ----------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@etontine.test"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Sanctum (tokens Bearer) ----------
# Durée de vie d'un token en minutes (10080 = 7 jours)
SANCTUM_TOKEN_EXPIRATION=10080
# Préfixe qui permet aux scanners de secrets (GitHub...) de repérer un token qui fuite
SANCTUM_TOKEN_PREFIX=etn_
